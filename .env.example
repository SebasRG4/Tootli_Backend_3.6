APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:/NC6CNBiDJb2vV4fRviEsMqy5gKbePRgk44JGkZFAYY=
APP_DEBUG=true
APP_URL=http://localhost
# Producción (OAuth, CSS/JS sin mixed content): debe ser https:// — sin barra final inconsistente
# APP_URL=https://tootli.mx
# Si tras Cloudflare las imágenes/CSS fallan, fuerza el origen (mismo host que APP_URL):
# ASSET_URL=https://tootli.mx
APP_MODE=dev

# Detrás de Nginx/Cloudflare: * = confiar solo en el proxy inmediato (REMOTE_ADDR).
# TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multi_food_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=database
QUEUE_CONNECTION=redis
REDIS_PREFIX=6ammart1767732708app_envlive_database_
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

REVERB_APP_ID=6ammart
REVERB_APP_KEY=6ammart
REVERB_APP_SECRET=6ammart
REVERB_HOST="${APP_URL}"
REVERB_PORT=6001
REVERB_SCHEME=http

PUSHER_APP_ID=6ammart
PUSHER_APP_KEY=6ammart
PUSHER_APP_SECRET=6ammart
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST="${APP_URL}"
PUSHER_PORT=6001
PUSHER_SCHEME=http

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Mapbox Directions API — cotización envío POS (ruta + tráfico). Sin valor → solo Haversine.
# 1) https://account.mapbox.com/ → Access tokens → Create a token
# 2) Tipo recomendado: Secret token (sk.ey...) para uso solo en este servidor (no en apps).
# 3) Scopes: incluir Directions (Navigation / Directions según el panel).
# 4) Tras cambiar .env: php artisan config:clear  (o sin caché de config en local).
#    Desde SSH sin editor: php artisan env:set MAPBOX_ACCESS_TOKEN --prompt
#    o: echo -n 'sk....' | php artisan env:set MAPBOX_ACCESS_TOKEN --stdin
# Docs: https://docs.mapbox.com/api/navigation/directions/
MAPBOX_ACCESS_TOKEN=
# Mapa en seguimiento web (Mapbox GL). Debe ser token público pk.… con restricción por dominio tootli.mx
MAPBOX_PUBLIC_ACCESS_TOKEN=
# (Opcional legacy) Si solo existe MAPBOX_TOKEN, config/services.php también la usa como respaldo.

# Reparto Tootli: filtrar GET latest-orders con DeliveryEligibilityService (COD, max concurrentes, rechazos Redis).
DM_FILTER_LATEST_ORDERS_ELIGIBILITY=true

# Strikes repartidor: ventana móvil (días) y umbral de peso acumulado para bloquear accept-order.
DM_STRIKES_ROLLING_DAYS=90
DM_STRIKES_BLOCK_WEIGHT=12

# Cancelación repartidor: exigir cancel_reason_id (order_cancel_reasons user_type=deliveryman). Legacy: texto en "reason".
DM_CANCEL_REQUIRE_REASON_ID=true
DM_CANCEL_ALLOW_LEGACY_TEXT=true
DM_CANCEL_MAX_EVIDENCE_PHOTOS=3
DM_CANCEL_MAX_PHOTO_KB=4096
DM_CANCEL_MAX_AUDIO_BYTES=5242880

# Google Gemini / AI Service
GEMINI_API_KEY=
AI_SERVICE_URL=http://127.0.0.1:8000

# OSRM Router - Enrutamiento propio gratuito (Docker compose service)
OSRM_BASE_URL=http://osrm:5000
